# FraudRadar Backend Environment Variables
PORT=5000

# Local MongoDB connection (default)
MONGODB_URI=mongodb://127.0.0.1:27017/fraudradar

# Or use MongoDB Atlas cloud connection:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fraudradar?retryWrites=true&w=majority

NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Secret API key required for analyst actions (confirm fraud, dismiss, seed data)
ANALYST_API_KEY=fraudradar-analyst-secret-key-2026
